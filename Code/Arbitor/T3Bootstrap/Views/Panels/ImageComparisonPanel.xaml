<UserControl x:Class="T3.Views.Panels.ImageComparisonPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:T3.ViewModels"
             xmlns:t3conv="clr-namespace:T3Foundation.Wpf.Converters;assembly=T3Foundation">
    <Grid Background="{DynamicResource T3Brush.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="8,6,8,4">
            <RadioButton Content="Side by Side" Margin="4"
                         IsChecked="{Binding ViewMode, Mode=TwoWay, Converter={t3conv:EnumToBoolConverter}, ConverterParameter={x:Static vm:ComparisonViewMode.SideBySide}}"/>
            <RadioButton Content="Overlay" Margin="4"
                         IsChecked="{Binding ViewMode, Mode=TwoWay, Converter={t3conv:EnumToBoolConverter}, ConverterParameter={x:Static vm:ComparisonViewMode.Overlay}}"/>
            <RadioButton Content="Error Pixels" Margin="4"
                         IsChecked="{Binding ViewMode, Mode=TwoWay, Converter={t3conv:EnumToBoolConverter}, ConverterParameter={x:Static vm:ComparisonViewMode.DiffOnly}}"/>
            <Slider Width="150" Minimum="0" Maximum="1" Value="{Binding OverlayOpacity}"
                    Margin="8,0,0,0" ToolTip="Overlay opacity"
                    Visibility="{Binding ViewMode, Converter={t3conv:EnumToBoolConverter}, ConverterParameter={x:Static vm:ComparisonViewMode.Overlay}}"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:ComparisonViewMode.SideBySide}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Rendered Image" Style="{DynamicResource T3PanelTitleTextStyle}" Grid.Row="0"/>
                <Border Grid.Row="1" Style="{DynamicResource T3ViewportFrameStyle}">
                    <Image Source="{Binding SelectedTestDetail.TestImage}" Stretch="Uniform"/>
                </Border>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Rendered Image + Error Pixels" Style="{DynamicResource T3PanelTitleTextStyle}" Grid.Row="0"/>
                <Border Grid.Row="1" Style="{DynamicResource T3ViewportFrameStyle}">
                    <Image Source="{Binding SelectedTestDetail.ErrorOverlayImage}" Stretch="Uniform"/>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:ComparisonViewMode.Overlay}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{DynamicResource T3ViewportFrameStyle}">
                <Grid>
                    <Image Source="{Binding SelectedTestDetail.ReferenceImage}" Stretch="Uniform"/>
                    <Image Source="{Binding SelectedTestDetail.TestImage}" Stretch="Uniform"
                           Opacity="{Binding OverlayOpacity}"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="{x:Type Grid}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViewMode}" Value="{x:Static vm:ComparisonViewMode.DiffOnly}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{DynamicResource T3ViewportFrameStyle}">
                <Image Source="{Binding SelectedTestDetail.ErrorOverlayImage}" Stretch="Uniform"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
