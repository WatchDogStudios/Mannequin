<UserControl x:Class="T3.Views.Panels.ResourceInspectorPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{DynamicResource T3PanelBodyStyle}" Margin="8">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Text="Captured State" Style="{DynamicResource T3SectionHeaderTextStyle}" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding SelectedTestDetail.ResourceSummary}"
                               Foreground="{Binding SelectedTestDetail.ResourceSummaryBrush}"
                               DockPanel.Dock="Right"/>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding SelectedTestDetail.ResourceSnapshots}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{DynamicResource T3InspectorItemStyle}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="{Binding StatusBrush}"
                                                   FontWeight="SemiBold"
                                                   DockPanel.Dock="Right"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="8" Height="8" CornerRadius="4"
                                                    Background="{Binding StatusBrush}"
                                                    Margin="0,4,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource T3Brush.TextMuted}"
                                               Margin="14,3,0,6"/>
                                    <Grid Margin="14,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="86"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Type" Style="{DynamicResource T3MutedTextStyle}" Grid.Row="0"/>
                                        <TextBlock Text="{Binding Type}" Grid.Row="0" Grid.Column="1"/>
                                        <TextBlock Text="Slot" Style="{DynamicResource T3MutedTextStyle}" Grid.Row="1"/>
                                        <TextBlock Text="{Binding Slot}" Grid.Row="1" Grid.Column="1"/>
                                        <TextBlock Text="Format" Style="{DynamicResource T3MutedTextStyle}" Grid.Row="2"/>
                                        <TextBlock Text="{Binding Format}" Grid.Row="2" Grid.Column="1"/>
                                        <TextBlock Text="Size" Style="{DynamicResource T3MutedTextStyle}" Grid.Row="3"/>
                                        <TextBlock Text="{Binding Dimensions}" Grid.Row="3" Grid.Column="1"/>
                                        <TextBlock Text="Memory" Style="{DynamicResource T3MutedTextStyle}" Grid.Row="4"/>
                                        <TextBlock Text="{Binding Memory}" Grid.Row="4" Grid.Column="1"/>
                                    </Grid>
                                    <Border Background="{DynamicResource T3Brush.PanelInset}"
                                            BorderBrush="{DynamicResource T3Brush.Border}"
                                            BorderThickness="1"
                                            Margin="14,0,0,6"
                                            Padding="4"
                                            Visibility="{Binding PreviewImage, Converter={StaticResource T3NullToVisibility}}">
                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" MaxHeight="160"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding Values}" Margin="14,0,0,6">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11"
                                                           Foreground="{DynamicResource T3Brush.TextMuted}"
                                                           TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding StateChecks}" Margin="14,0,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,3">
                                                    <TextBlock Text="{Binding StatusText}"
                                                               Foreground="{Binding StatusBrush}"
                                                               FontWeight="SemiBold"
                                                               DockPanel.Dock="Right"/>
                                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource T3Brush.TextMuted}"/>
                                                    <TextBlock Text=" / " Foreground="{DynamicResource T3Brush.TextMuted}"/>
                                                    <TextBlock Text="{Binding CallName}"/>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
