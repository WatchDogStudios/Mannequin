<UserControl x:Class="T3.Views.Panels.SummaryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8" Background="{DynamicResource T3Brush.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Test Run Summary" FontWeight="Bold" FontSize="14"/>
            <Separator Margin="0,4,0,8"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Total: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TotalTests}"/>
                <TextBlock Text="  |  Passed: " FontWeight="SemiBold" Foreground="Green" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding PassedCount}" Foreground="Green"/>
                <TextBlock Text="  |  Failed: " FontWeight="SemiBold" Foreground="Red" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding FailedCount}" Foreground="Red"/>
                <TextBlock Text="  |  Skipped: " FontWeight="SemiBold" Foreground="Gray" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding SkippedCount}" Foreground="Gray"/>
                <TextBlock Text="  |  New Baselines: " FontWeight="SemiBold" Foreground="DodgerBlue" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding NewBaselines}" Foreground="DodgerBlue"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Total Time: " FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TotalTime}"/>
            </StackPanel>
            <ProgressBar Height="8" Margin="0,8,0,0" Value="{Binding TestProgress, Mode=OneWay}"/>
        </StackPanel>
    </Grid>
</UserControl>
