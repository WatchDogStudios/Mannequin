<UserControl x:Class="T3.Views.Panels.TestListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t3="clr-namespace:T3Foundation.Wpf.Behaviors;assembly=T3Foundation">
    <Grid Background="{DynamicResource T3Brush.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" Margin="4"
                 Text="{Binding TestFilter, UpdateSourceTrigger=PropertyChanged}"
                 t3:T3Behaviors.Watermark="Filter tests..."/>
        <ListBox Grid.Row="1" Margin="4"
                 ItemsSource="{Binding TestItems}"
                 SelectedItem="{Binding SelectedTest}"
                 SelectionMode="Extended"
                 t3:T3Behaviors.AutoScroll="False">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Ellipse Width="12" Height="12" Margin="0,0,8,0"
                                 Fill="{Binding StatusBrush}"/>
                        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding MeanErrorText}" Foreground="Gray"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
