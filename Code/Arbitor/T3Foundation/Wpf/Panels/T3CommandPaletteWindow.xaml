<Window x:Class="T3Foundation.Wpf.Panels.T3CommandPaletteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t3="clr-namespace:T3Foundation.Wpf.Behaviors"
        Title="Command Palette"
        Width="640" Height="420"
        WindowStyle="None"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource T3Brush.PanelRaised}"
            BorderBrush="{DynamicResource T3Brush.Accent}"
            BorderThickness="1"
            CornerRadius="4"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="2" Opacity="0.6"/>
        </Border.Effect>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox Grid.Row="0"
                     x:Name="QueryBox"
                     FontSize="16"
                     Padding="6"
                     t3:T3Behaviors.Watermark="Type a command..."
                     TextChanged="OnQueryChanged"
                     PreviewKeyDown="OnQueryKeyDown"/>

            <ListBox Grid.Row="1"
                     x:Name="ResultList"
                     Margin="0,8,0,8"
                     ItemsSource="{Binding Filtered, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                     MouseDoubleClick="OnResultDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Title}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Source}"
                                       Foreground="{DynamicResource T3Brush.TextMuted}"
                                       FontSize="11"
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2"
                       Foreground="{DynamicResource T3Brush.TextMuted}"
                       FontSize="11"
                       Text="Enter to run  -  Esc to close  -  Up/Down to navigate"/>
        </Grid>
    </Border>
</Window>
