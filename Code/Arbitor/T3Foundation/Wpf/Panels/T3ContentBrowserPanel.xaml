<UserControl x:Class="T3Foundation.Wpf.Panels.T3ContentBrowserPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t3="clr-namespace:T3Foundation.Wpf.Behaviors">
    <Grid Background="{DynamicResource T3Brush.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="4">
            <TextBlock x:Name="Breadcrumb"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource T3Brush.TextMuted}"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="SearchBox"
                     t3:T3Behaviors.Watermark="Search assets..."
                     TextChanged="OnSearchChanged"/>
        </DockPanel>

        <ListBox Grid.Row="1"
                 x:Name="ItemList"
                 ItemsSource="{Binding FilteredItems, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="OnSelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Width="96" Height="96"
                            Margin="4"
                            Background="{DynamicResource T3Brush.PanelRaised}"
                            BorderBrush="{DynamicResource T3Brush.Border}"
                            BorderThickness="1"
                            ToolTip="{Binding Name}">
                        <Grid>
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="6,6,6,22"/>
                            <TextBlock Text="{Binding Name}"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="10"
                                       Margin="2,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
