<UserControl x:Class="T3Foundation.Wpf.Panels.T3OutputLogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:t3="clr-namespace:T3Foundation.Wpf.Behaviors"
             xmlns:t3mark="clr-namespace:T3Foundation.Wpf.MarkupExtensions">
    <Grid Background="{DynamicResource T3Brush.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar: filter + search + auto-scroll + clear -->
        <DockPanel Grid.Row="0" Margin="4" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Click="OnClearClick"
                    ToolTip="Clear log"
                    Padding="6,2"
                    Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Content="{t3mark:T3Icon Name=Solid_Broom, Size=11}" Margin="0,0,4,0"/>
                    <TextBlock Text="Clear"/>
                </StackPanel>
            </Button>
            <CheckBox DockPanel.Dock="Right"
                      x:Name="AutoScrollCheck"
                      Content="Auto-scroll"
                      IsChecked="True"
                      Margin="8,0,0,0"
                      VerticalAlignment="Center"/>
            <ComboBox DockPanel.Dock="Left"
                      x:Name="LevelFilter"
                      MinWidth="100"
                      SelectedIndex="0"
                      SelectionChanged="OnLevelFilterChanged"
                      Margin="0,0,4,0">
                <ComboBoxItem Content="All"/>
                <ComboBoxItem Content="Debug+"/>
                <ComboBoxItem Content="Info+"/>
                <ComboBoxItem Content="Warning+"/>
                <ComboBoxItem Content="Error+"/>
            </ComboBox>
            <TextBox x:Name="SearchBox"
                     t3:T3Behaviors.Watermark="Search..."
                     TextChanged="OnSearchChanged"/>
        </DockPanel>

        <!-- Rows -->
        <ListBox Grid.Row="1"
                 x:Name="LogList"
                 ItemsSource="{Binding Entries, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                 FontFamily="Consolas"
                 FontSize="11"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 t3:T3Behaviors.AutoScroll="True">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy" Click="OnCopyClick"/>
                    <MenuItem Header="Copy All" Click="OnCopyAllClick"/>
                    <Separator/>
                    <MenuItem Header="Clear" Click="OnClearClick"/>
                </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Text}"
                               Foreground="{Binding LevelBrush}"
                               TextWrapping="NoWrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
