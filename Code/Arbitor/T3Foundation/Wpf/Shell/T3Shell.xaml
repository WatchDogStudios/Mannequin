<!--
    T3Shell.xaml
    Default control templates for T3ShellWindow and T3StatusBar.

    The Window template has four rows:
        Row 0  PART_TitleBar     (chromed title strip + window buttons + workspace dropdown)
        Row 1  PART_MenuHost     (data-driven Menu, populated by IT3MenuService in Phase 3)
               PART_ToolbarHost  (data-driven ToolBarAdv, populated by IT3ToolbarService)
        Row 2  PART_DockHost     (Syncfusion DockingManager - tool-window canvas)
        Row 3  PART_StatusHost   (T3StatusBar - status text + log tail + accessory)

    All references to brushes/styles defined in T3Resources.xaml use
    DynamicResource because this dictionary is loaded as a merged dictionary
    of T3Resources.xaml and the local brushes/styles aren't defined yet at
    parse time. DynamicResource resolves at template-application time.

    For the same reason we do NOT use BasedOn="{x:Type Window}" - that
    resolves to the implicit Window style which isn't defined yet. We set
    the inherited properties (Background, Foreground, FontFamily) explicitly.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:winshell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:shell="clr-namespace:T3Foundation.Wpf.Shell"
    xmlns:t3conv="clr-namespace:T3Foundation.Wpf.Converters"
    xmlns:t3mark="clr-namespace:T3Foundation.Wpf.MarkupExtensions">

    <!--
        Locally-declared converter so the StaticResource lookup inside this
        dictionary's templates resolves at parse time. The same key is also
        registered in T3Resources.xaml; the local one wins inside this scope.
    -->
    <t3conv:T3IconKeyConverter x:Key="T3IconKeyConverter" Size="14"/>

    <!-- ============================================================ -->
    <!-- T3ShellWindow                                                 -->
    <!-- ============================================================ -->
    <Style TargetType="{x:Type shell:T3ShellWindow}">
        <Setter Property="Background" Value="{DynamicResource T3Brush.Window}"/>
        <Setter Property="Foreground" Value="{DynamicResource T3Brush.Text}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="WindowStyle" Value="None"/>
        <Setter Property="ResizeMode" Value="CanResize"/>
        <Setter Property="AllowsTransparency" Value="False"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <winshell:WindowChrome
                    CaptionHeight="0"
                    ResizeBorderThickness="6"
                    GlassFrameThickness="0"
                    CornerRadius="0"
                    UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shell:T3ShellWindow}">
                    <Grid Background="{DynamicResource T3Brush.Window}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="36"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="26"/>
                        </Grid.RowDefinitions>

                        <!-- ===== PART_TitleBar ===== -->
                        <Border x:Name="PART_TitleBar"
                                Grid.Row="0"
                                Background="{DynamicResource T3Brush.TitleBar}"
                                BorderBrush="{DynamicResource T3Brush.Border}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- App icon + title -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <ContentControl Content="{t3mark:T3Icon Name=Solid_Cube, Size=14}"
                                                    Margin="0,0,8,0"/>
                                    <TextBlock Text="{TemplateBinding Title}"
                                               Foreground="{DynamicResource T3Brush.Text}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Workspace switcher (collapses when no workspaces are registered) -->
                                <ComboBox Grid.Column="2"
                                          MinWidth="120"
                                          Margin="0,4,12,4"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding ShellViewModel.Workspaces, RelativeSource={RelativeSource TemplatedParent}}"
                                          SelectedItem="{Binding ShellViewModel.CurrentWorkspace, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          ToolTip="Workspace"
                                          WindowChrome.IsHitTestVisibleInChrome="True">
                                    <ComboBox.Style>
                                        <Style TargetType="{x:Type ComboBox}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ShellViewModel.Workspaces.Count, RelativeSource={RelativeSource AncestorType={x:Type shell:T3ShellWindow}}}" Value="0">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>

                                <!-- Window buttons -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                                    <Button Style="{DynamicResource T3TitleBarButtonStyle}"
                                            Command="{Binding ShellViewModel.MinimizeCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            ToolTip="Minimize">
                                        <ContentControl Content="{t3mark:T3Icon Name=Solid_WindowMinimize, Size=12}"/>
                                    </Button>
                                    <Button Style="{DynamicResource T3TitleBarButtonStyle}"
                                            Command="{Binding ShellViewModel.MaximizeRestoreCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            ToolTip="Maximize">
                                        <ContentControl Content="{t3mark:T3Icon Name=Regular_WindowMaximize, Size=12}"/>
                                    </Button>
                                    <Button Style="{DynamicResource T3TitleBarCloseButtonStyle}"
                                            Command="{Binding ShellViewModel.CloseCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            ToolTip="Close">
                                        <ContentControl Content="{t3mark:T3Icon Name=Solid_Times, Size=12}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- ===== PART_MenuHost + PART_ToolbarHost (stacked Auto row) ===== -->
                        <StackPanel Grid.Row="1" Orientation="Vertical">

                            <!-- Data-driven menu populated by IT3MenuService -->
                            <Menu x:Name="PART_MenuHost"
                                  Background="{DynamicResource T3Brush.TitleBar}"
                                  Foreground="{DynamicResource T3Brush.Text}"
                                  ItemsSource="{Binding ShellViewModel.MenuItems, RelativeSource={RelativeSource TemplatedParent}}">
                                <Menu.Style>
                                    <Style TargetType="{x:Type Menu}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShellViewModel.MenuItems.Count, RelativeSource={RelativeSource AncestorType={x:Type shell:T3ShellWindow}}}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Menu.Style>
                                <Menu.ItemContainerStyle>
                                    <Style TargetType="{x:Type MenuItem}">
                                        <Setter Property="Header" Value="{Binding Header}"/>
                                        <Setter Property="ItemsSource" Value="{Binding Children}"/>
                                        <Setter Property="Command" Value="{Binding Command}"/>
                                        <Setter Property="CommandParameter" Value="{Binding CommandParameter}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type MenuItem}">
                                                            <Separator/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Menu.ItemContainerStyle>
                            </Menu>

                            <!-- Data-driven toolbar populated by IT3ToolbarService -->
                            <syncfusion:ToolBarAdv x:Name="PART_ToolbarHost"
                                                   Background="{DynamicResource T3Brush.TitleBar}"
                                                   ItemsSource="{Binding ShellViewModel.ToolbarItems, RelativeSource={RelativeSource TemplatedParent}}">
                                <syncfusion:ToolBarAdv.Style>
                                    <Style TargetType="{x:Type syncfusion:ToolBarAdv}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShellViewModel.ToolbarItems.Count, RelativeSource={RelativeSource AncestorType={x:Type shell:T3ShellWindow}}}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </syncfusion:ToolBarAdv.Style>
                                <syncfusion:ToolBarAdv.ItemTemplateSelector>
                                    <shell:T3ToolbarItemTemplateSelector>
                                        <shell:T3ToolbarItemTemplateSelector.ButtonTemplate>
                                            <DataTemplate>
                                                <Button Style="{DynamicResource T3ToolbarButtonStyle}"
                                                        Command="{Binding Command}"
                                                        CommandParameter="{Binding CommandParameter}"
                                                        ToolTip="{Binding Tooltip}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ContentControl Content="{Binding IconKey, Converter={StaticResource T3IconKeyConverter}}"
                                                                        Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Label}"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </shell:T3ToolbarItemTemplateSelector.ButtonTemplate>
                                        <shell:T3ToolbarItemTemplateSelector.SeparatorTemplate>
                                            <DataTemplate>
                                                <Separator/>
                                            </DataTemplate>
                                        </shell:T3ToolbarItemTemplateSelector.SeparatorTemplate>
                                        <shell:T3ToolbarItemTemplateSelector.LabelTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Label}"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,4,0"
                                                           Foreground="{DynamicResource T3Brush.TextMuted}"/>
                                            </DataTemplate>
                                        </shell:T3ToolbarItemTemplateSelector.LabelTemplate>
                                        <shell:T3ToolbarItemTemplateSelector.SpacerTemplate>
                                            <DataTemplate>
                                                <FrameworkElement Width="8"/>
                                            </DataTemplate>
                                        </shell:T3ToolbarItemTemplateSelector.SpacerTemplate>
                                        <shell:T3ToolbarItemTemplateSelector.CustomTemplate>
                                            <DataTemplate>
                                                <ContentPresenter Content="{Binding Content}"/>
                                            </DataTemplate>
                                        </shell:T3ToolbarItemTemplateSelector.CustomTemplate>
                                    </shell:T3ToolbarItemTemplateSelector>
                                </syncfusion:ToolBarAdv.ItemTemplateSelector>
                            </syncfusion:ToolBarAdv>
                        </StackPanel>

                        <!-- ===== PART_DockHost ===== -->
                        <syncfusion:DockingManager x:Name="PART_DockHost"
                                                   Grid.Row="2"
                                                   UseDocumentContainer="True"
                                                   PersistState="True"
                                                   Background="{DynamicResource T3Brush.Window}"/>

                        <!-- ===== PART_StatusHost ===== -->
                        <shell:T3StatusBar x:Name="PART_StatusHost"
                                           Grid.Row="3"
                                           StatusText="{Binding ShellViewModel.StatusText, RelativeSource={RelativeSource TemplatedParent}}"
                                           AccessoryText="{Binding ShellViewModel.StatusAccessoryText, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- T3StatusBar                                                   -->
    <!-- ============================================================ -->
    <Style TargetType="{x:Type shell:T3StatusBar}">
        <Setter Property="Background" Value="{DynamicResource T3Brush.TitleBar}"/>
        <Setter Property="Foreground" Value="{DynamicResource T3Brush.TextMuted}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource T3Brush.Border}"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type shell:T3StatusBar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{TemplateBinding StatusText}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding LogTailText}"
                                       Foreground="{DynamicResource T3Brush.TextMuted}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="16,0,16,0"
                                       Opacity="0.85"/>

                            <TextBlock Grid.Column="2"
                                       Text="{TemplateBinding AccessoryText}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
